; Chel requires Tailscale for phone access: install it together with Chel.
!macro NSIS_HOOK_POSTINSTALL
  IfFileExists "$PROGRAMFILES64\Tailscale\tailscale.exe" chel_ts_done
  DetailPrint "Instalando o Tailscale (necessário para usar o Chel no celular)..."
  nsExec::ExecToLog 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand '
  Pop $0
  StrCmp $0 "0" chel_ts_done
  StrCmp $0 "3010" chel_ts_done
  MessageBox MB_ICONEXCLAMATION|MB_OK "Não foi possível instalar o Tailscale (código $0). O Chel funciona no PC, mas para usar no celular instale o Tailscale em tailscale.com/download."
  chel_ts_done:
!macroend
