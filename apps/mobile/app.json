{
  "expo": {
    "name": "Chel",
    "slug": "chel",
    "scheme": "chel",
    "version": "0.2.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Chel leia o QR Code de pareamento."
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.local.chel.remote"
    },
    "ios": {
      "bundleIdentifier": "com.local.chel.remote",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
